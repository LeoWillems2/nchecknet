

## assume the nchecknet service is running on nc.server.nl
##   (YConfig.Collector.CollectorURL collectorurl in nchecknet.yml)

## 1) on the service side (nc.server.nl):
## add new server to monitor:    -O for: owner
./utils -ns  newserver.domain  -O iWoz

## 2) on the service side (nc.server.nl):
## generate the rawcollectorscript for server that must be monitored:
./utils -cs newserver.domain >rawcollector.py
## cp rawcollector.py to newserver.domain, chmod +x and run daily (cron) as root
## on nc.server.nl: open firewall on dport 8187 for src-IP from newserver.domain



## 3) for every interface on newserver.domain create an nmap script that is copied to
##  some host on the network that routes to that interface.
##   caveat for -i: that entry must exist in the database, so wait a day after step 2.
 for int in eth0 tun0
 do
    ./utils -nm -s newserver.domain -i 20250101 -if $int >$int.py
    ## cp $int.py to the host, chmod +x and run daily (cron) as root
 done
